# Copy to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# --- Site ---------------------------------------------------------------------
# Canonical site URL. Drives OG image URLs, sitemap, robots.txt, JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mochi-cli.com

# Twitter / X handle including the @. Leave blank to omit twitter:site/creator.
NEXT_PUBLIC_TWITTER_HANDLE=

# --- SEO verification (optional) ----------------------------------------------
# From Google Search Console → HTML tag method → content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# From Yandex.Webmaster.
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Polar checkout -----------------------------------------------------------
# Polar access token — Server-only. Get from Polar dashboard → Settings → Access Tokens.
POLAR_ACCESS_TOKEN=

# Where Polar redirects the user after successful checkout. {CHECKOUT_ID} is substituted.
POLAR_SUCCESS_URL=https://mochi-cli.com/success?checkout_id={CHECKOUT_ID}

# Public product ID for the Pro plan. Get from Polar dashboard → Products → your Pro product → ID.
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=

# --- Free-plan waitlist (optional) --------------------------------------------
# Set to "true" to show the email capture on the Free card. Leave unset and the
# card falls back to the plain "Soon" state.
NEXT_PUBLIC_WAITLIST_ENABLED=

# Resend API key — server-only. Dashboard -> API Keys.
RESEND_API_KEY=

# Resend audience the waitlist writes into. Dashboard -> Audiences -> your audience -> ID.
RESEND_AUDIENCE_ID=

# ─── Account service ─────────────────────────────────────────────────────────
# Sign-in and billing run from this same deployment. SERVICE_ORIGIN is this
# site's own origin: it is what Google redirects back to and what Polar posts
# webhooks to, so those two settings have to name the same host.

# Copy to .env.local and fill in. Never commit the filled-in copy.
# In production every one of these is a Vercel environment variable.

# Public origin of this service. Google's redirect URI and Polar's return
# URLs are built from it, so it has to match what is registered with both.
SERVICE_ORIGIN=https://mochi-cli.com

# Neon (Vercel Marketplace). The pooled connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Google OAuth client, scope `openid email` only — see src/lib/google.ts for
# why the narrow scope is load-bearing rather than tidiness.
# Authorised redirect URI: $SERVICE_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Polar, the merchant of record. An organization access token, created under
# Settings, not a personal one — a personal token dies with the person.
# Same token as POLAR_ACCESS_TOKEN above: one Polar account serves both the
# one-off checkout on this site and the subscriptions the service manages.
POLAR_ACCESS_TOKEN=polar_oat_replace_me

# From the webhook endpoint you register at $SERVICE_ORIGIN/webhooks/polar,
# not from the tokens page. Base64, per the Standard Webhooks spec.
POLAR_WEBHOOK_SECRET=replace-me

# Polar sells *products*, not prices. One product per billing cadence.
POLAR_PRODUCT_MONTHLY=00000000-0000-0000-0000-000000000000
POLAR_PRODUCT_YEARLY=00000000-0000-0000-0000-000000000000

# "sandbox" while building, "production" when live. Sandbox is a wholly
# separate Polar instance with its own tokens and its own product ids, so
# pointing production at sandbox silently makes every paying customer free.
POLAR_SERVER=sandbox

# Which key signs the entitlement claim. Ships in the desktop build's key map,
# so changing it is how a compromised key gets retired.
CLAIM_KID=2026-09

# Production: Cloud KMS. The private key is generated there and never leaves,
# so there is no environment variable holding it. Note this names a key
# *version* — asymmetricSign will not accept the key itself.
#   projects/P/locations/global/keyRings/R/cryptoKeys/K/cryptoKeyVersions/1
CLAIM_KMS_KEY=

# The service account that may call asymmetricSign on that one key, as the
# whole downloaded JSON on a single line. Needed because Vercel has no metadata
# server for the Google libraries to ask. Leave empty locally, where `gcloud
# auth application-default login` covers it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local development only. Refused when NODE_ENV or VERCEL_ENV is production —
# a signing key in an environment variable is one crash dump away from minting
# Pro forever. Generate one with:
#   openssl genpkey -algorithm ed25519
CLAIM_SIGNING_KEY=

# How long a claim is believed. Days, not hours: this doubles as the offline
# grace period, so a short value turns a brief outage into a support queue.
#
# It is also how long a cancelled subscription keeps Pro, which is the cost of
# a long one — bounded and small, since that person had already stopped paying.
# The cost of a short one is unbounded and lands on customers who *are* paying,
# on a plane or a bad connection. Err long. Refused above 90, at zero, and on
# anything that is not a number.
CLAIM_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Plan limits — optional, and normally left unset.
#
# The app ships with its own numbers and uses them when nothing here says
# otherwise. Set one and it is signed into every claim from then on, reaching
# each signed-in machine on its next daily refresh, believed offline until that
# claim expires, and needing no release — which is the point: the app's own
# copy is compiled in, and with no auto-updater an installed copy keeps it.
#
# UNSET IS NOT ZERO. An empty value means "say nothing"; a zero would be signed,
# believed everywhere at once, and refuse every agent call. The service refuses
# to start a claim with one rather than sign it.
#
# Nothing here reaches a signed-out person: they have no claim, and an install
# nobody signed in to does not talk to this service at all.
#
# Shipped defaults, for reference: free 2000 calls / 25 MB, pro unlimited /
# 100 MB. An attachment size above the shipped Pro size is capped by the app,
# because that is what its storage layer will actually accept.
# LIMIT_FREE_MCP_CALLS_PER_WEEK=2000
# LIMIT_FREE_ATTACHMENT_MB=25
# LIMIT_PRO_MCP_CALLS_PER_WEEK=unlimited
# LIMIT_PRO_ATTACHMENT_MB=100
